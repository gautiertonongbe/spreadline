# Spreadline configuration.
#
# Copy to .env and adjust. Every value here has a safe default in
# backend/app/core/config.py, so an empty .env still boots.

# --- Application -------------------------------------------------------
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ----------------------------------------------------------
# Postgres in every real environment. SQLite is supported for a first run and
# for the test suite, so the platform starts without a database server:
#   DATABASE_URL=sqlite+pysqlite:///./spreadline.db
DATABASE_URL=postgresql+psycopg://spreadline:spreadline@localhost:5432/spreadline

# --- CORS --------------------------------------------------------------
# Must list the exact origin the frontend is served from, including the port.
# A mismatch here is the usual cause of "Failed to fetch" in the browser while
# the API answers curl perfectly well.
CORS_ORIGINS=http://localhost:3000

# --- Providers ---------------------------------------------------------
# Comma separated, with three shorthands:
#   mock  the fixture providers for both marketplaces
#   free  Best Buy and eBay: real data, free keys, no seller account
#   all   every platform in the catalogue, so the Providers screen shows the
#         full picture including the ones that are not implemented yet
# The platform prefers a configured live provider over a fixture automatically,
# with no code change, so switching to real data is this one line plus the keys.
ENABLED_PROVIDERS=mock

# --- Live data, free, no seller account --------------------------------
# These two are implemented and wired to real endpoints. Setting them is all it
# takes to stop using fixtures.
#
# Best Buy: free developer key, instant, at https://developer.bestbuy.com
#   Returns UPC and shipping weight, which the identity and fee engines need.
#   A free key covers development and testing; commercial use needs a partner
#   agreement with Best Buy.
BESTBUY_API_KEY=

# eBay: free developer account at https://developer.ebay.com
#   5,000 calls per day, no per-request cost. Supports GTIN lookup, so a product
#   found at a retailer is matched on the marketplace by identifier rather than
#   by title. Use "sandbox" while testing credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENVIRONMENT=production

# --- Live data, seller account required --------------------------------
# Adapters and payload mappers are implemented and tested; the transports are
# unwired. Leave these empty and they report themselves as not configured rather
# than silently falling back to fixture data.
AMAZON_PROVIDER_CREDENTIALS=
WALMART_PROVIDER_CREDENTIALS=

PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_PER_SECOND=5
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_SECONDS=60

# --- Freshness (seconds) ----------------------------------------------
TTL_CURRENT_PRICE_SECONDS=900
TTL_AVAILABILITY_SECONDS=900
TTL_COMPETITION_SECONDS=3600
TTL_DEMAND_SECONDS=21600
TTL_PRICE_HISTORY_SECONDS=86400
TTL_PRODUCT_METADATA_SECONDS=604800

# --- Spreadline's own history -----------------------------------------
# Every legitimate provider answer is persisted as a timestamped observation, so
# the intelligence engine gets less dependent on third-party history over time.
# On by default: a dataset only has value if it was accumulating from day one.
HISTORY_CAPTURE_ENABLED=true
# Listings polled per scheduled run, and how often the run happens. Bounded so a
# scheduled job cannot grow into an unplanned provider bill.
HISTORY_REFRESH_BATCH_SIZE=25
HISTORY_REFRESH_INTERVAL_SECONDS=900
# Upper bound on the tracked universe. Spreadline observes what you work on; it
# does not crawl a marketplace.
HISTORY_UNIVERSE_LIMIT=500

# --- Scheduling --------------------------------------------------------
# Off by default. When on, tracked listings are re-polled once their price TTL
# expires, in bounded batches.
SCHEDULER_ENABLED=false
SCHEDULER_BACKEND=apscheduler

# --- Observability -----------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- AI (optional layer, off by default) ------------------------------
# AI never calculates money and never overrides product identity. It can only
# propose, and its proposals are capped below the high-confidence band.
AI_ENABLED=false
AI_PROVIDER=null
AI_MODEL=claude-sonnet-5
AI_API_KEY=
AI_MAX_MATCH_CONFIDENCE=0.80

# --- Frontend ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
